# Turbo Karts backend (Supabase). The ANON key is a PUBLIC client key (it ships in
# every web build) — safe to expose. Both values are baked into web/bridge.js at build
# time. No service-role key is used in the game itself.
#
# Persistence: the coin wallet + garage live in Postgres, in table
#   public."<VITE_TABLE_PREFIX>_profiles"
# accessed ONLY through server-authoritative SECURITY DEFINER RPCs
# (usr_nmexs7bytxq2_tk_login / _tk_bank / _tk_buy / _tk_select) — see
# supabase/migrations/. Multiplayer uses Supabase Realtime *broadcast* (no tables).

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_TABLE_PREFIX=usr_nmexs7bytxq2_turbo_karts
