# Turbo Karts uses Supabase Realtime *broadcast* for multiplayer (no database
# tables, no auth). These values are baked into web/bridge.js at build time.
# The ANON key is a PUBLIC client key (it ships in every web build) — safe to expose.
# No service-role key is used anywhere in this project.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
